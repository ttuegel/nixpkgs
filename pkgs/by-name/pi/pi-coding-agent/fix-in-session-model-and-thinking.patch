+	it("setModel and setThinkingLevel do not change the global default settings", async () => {
+		const harness = await createHarness({
+			models: [
+				{ id: "faux-1", name: "One", reasoning: true },
+				{ id: "faux-2", name: "Two", reasoning: true },
+			],
+		});
+		harnesses.push(harness);
+		const nextModel = harness.getModel("faux-2")!;
+
+		expect(harness.settingsManager.getDefaultModel()).toBeUndefined();
+		expect(harness.settingsManager.getDefaultProvider()).toBeUndefined();
+		expect(harness.settingsManager.getDefaultThinkingLevel()).toBeUndefined();
+
+		await harness.session.setModel(nextModel);
+		harness.session.setThinkingLevel("high");
+
+		// Session-local state and session entries DID change.
+		expect(harness.session.model?.id).toBe("faux-2");
+		expect(harness.session.thinkingLevel).toBe("high");
+		const entries = harness.sessionManager.getEntries();
+		expect(entries.some((entry) => entry.type === "model_change")).toBe(true);
+		expect(entries.some((entry) => entry.type === "thinking_level_change")).toBe(true);
+
+		// Global defaults are UNCHANGED.
+		expect(harness.settingsManager.getDefaultModel()).toBeUndefined();
+		expect(harness.settingsManager.getDefaultProvider()).toBeUndefined();
+		expect(harness.settingsManager.getDefaultThinkingLevel()).toBeUndefined();
+	});
+
